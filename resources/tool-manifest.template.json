{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Pinned tool versions and SHA-256 checksums for reproducible builds.",
  "version": "1.0.0",
  "tools": {
    "piper": {
      "version": "2023.11.14-2",
      "url": "https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_windows_amd64.zip",
      "sha256": "PLACEHOLDER_PIPER_SHA256",
      "extract_to": "tools/piper"
    },
    "piper-model": {
      "version": "en_US-amy-medium",
      "url": "https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/amy/medium/en_US-amy-medium.onnx",
      "sha256": "PLACEHOLDER_MODEL_SHA256",
      "extract_to": "tools/piper/model.onnx"
    },
    "piper-model-json": {
      "version": "en_US-amy-medium",
      "url": "https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/amy/medium/en_US-amy-medium.onnx.json",
      "sha256": "PLACEHOLDER_MODEL_JSON_SHA256",
      "extract_to": "tools/piper/model.onnx.json"
    },
    "whisper": {
      "version": "cc7e72f",
      "url": "https://github.com/ggerganov/whisper.cpp/releases/download/v1.5.4/whisper-bin-x64.zip",
      "sha256": "PLACEHOLDER_WHISPER_SHA256",
      "extract_to": "tools/whisper/Release"
    },
    "whisper-model": {
      "version": "tiny.en",
      "url": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin",
      "sha256": "PLACEHOLDER_WHISPER_MODEL_SHA256",
      "extract_to": "tools/models/ggml-tiny.en.bin"
    }
  }
}
